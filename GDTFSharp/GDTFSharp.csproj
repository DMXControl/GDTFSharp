<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>GDTFSharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy node classes from the first prototype. They are superseded by the model + reader/writer design
         and are kept only as a reference until they are ported in Phase 2 (AttributeDefinitions). -->
    <Compile Remove="Models/Nodes/**" />
    <None Include="Models/Nodes/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GDTFSharp.Tests" />
  </ItemGroup>

</Project>
